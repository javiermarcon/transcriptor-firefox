{
  "manifest_version": 3,
  "name": "Meetings Transcriptor (host local)",
  "version": "0.3.3",
  "description": "Controla un transcriptor LOCAL de Google Meet. Requiere el host com.meetings.transcriptor (repo companion). No sube audio a internet.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meetings-transcriptor@example.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "Meetings Transcriptor (host local)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "page": "background/background.html"
  },
  "permissions": ["nativeMessaging", "activeTab"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "shared/meet-event-schema.js",
        "shared/meet-participant-diff.js",
        "shared/meet-speaker-diff.js",
        "shared/meet-dom-snapshot.js",
        "shared/meet-observation.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
