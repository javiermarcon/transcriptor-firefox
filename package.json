{
  "name": "meetings-transcriptor-firefox",
  "version": "0.3.3",
  "private": true,
  "license": "MIT",
  "description": "Extensión Firefox para controlar el transcriptor local de reuniones",
  "repository": {
    "type": "git",
    "url": "https://github.com/javiermarcon/transcriptor-firefox.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:manifest": "node scripts/validate-manifest.js",
    "check": "npm run format:check && npm run lint && npm run validate:manifest && npm run test:coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "c8": "^10.1.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2"
  }
}
